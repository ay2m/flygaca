{
  "name": "flygaca-server",
  "private": true,
  "type": "module",
  "description": "Fly GACA API — Express service for Cloud Run. Auth, account sync, entitlements, billing and the Captain Adel chat gateway.",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "node scripts/dev.mjs",
    "start": "node lib/index.js",
    "migrate": "node scripts/migrate.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "node scripts/link-lint-typescript.mjs"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "qs": ">=6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "eslint-plugin-import": "^2.25.4",
    "globals": "^17.8.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  }
}
