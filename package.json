{
  "name": "flygaca",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "type": "module",
  "description": "Fly GACA — independent educational platform and open regulatory library for Saudi civil aviation. React + TypeScript frontend with a first-party Cloud Run API.",
  "author": "BDA Company International (شركة بدع الدولية)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build:airports": "node scripts/build-airports.mjs",
    "build:chunks": "node scripts/build-rag-chunks.mjs",
    "shard:data": "node scripts/shard-airports.mjs && node scripts/shard-library-search.mjs",
    "gen:clause-anchors": "node scripts/generate-clause-anchors.mjs",
    "optimize:img": "node scripts/optimize-images.mjs",
    "gen:og": "node scripts/build-og-images.mjs",
    "gen:aip-sheet": "node scripts/build-aip-study-sheet.mjs",
    "build": "npm run build:sitemap && tsc -b && vite build && node scripts/prerender-head.mjs && npm run check:prerender && npm run check:jsonld",
    "build:deploy": "npm run build && npm run prerender && npm run check:prerender:coverage && npm run check:jsonld && npm run indexnow",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:jsonld": "node scripts/validate-jsonld.mjs",
    "prerender": "node scripts/prerender.mjs",
    "check:prerender:coverage": "node scripts/check-prerender-coverage.mjs",
    "sync:gaca": "node scripts/sync-gaca.mjs",
    "sync:gaca:apply": "node scripts/sync-gaca.mjs --apply && npm run data:normalize",
    "data:normalize": "node scripts/normalize-corpus-data.mjs",
    "lint:md": "markdownlint-cli2 \"content/regulations/**/*.md\"",
    "parse:regulations": "node scripts/parse-regulations.mjs",
    "embeddings:upsert": "node scripts/upsert-embeddings.mjs",
    "gen:captain": "node scripts/generate-captain-adel.mjs",
    "new:guide": "node scripts/new-guide.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:perf": "node scripts/check-perf-budget.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "audit:ai": "node scripts/audit-ai-visibility.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:bundle && npm run check:perf",
    "check:moyasar": "node scripts/check-moyasar.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:a11y": "vitest run tests/a11y/ --config config/vitest.config.ts",
    "test:animation": "vitest run tests/bento-motion-parity.test.ts --config config/vitest.config.ts",
    "perf-audit": "node scripts/perf-audit.mjs",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "build:flavor": "node scripts/build-flavor.mjs",
    "flavor:ios": "node scripts/flavor-ios.mjs",
    "build:apps-content": "node scripts/build-ios-content.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:localize": "node scripts/native/ios-localize.mjs",
    "cap:open": "cap open ios",
    "screenshots:help": "cat screenshots/README.md",
    "serve": "npm run build && vite preview --port 5000",
    "deploy": "echo \"Deploy to Vercel via vercel CLI or Git push\" && exit 0",
    "deploy:api": "node scripts/deploy-api.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "headers:gcloud": "node scripts/headers-gcloud.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "db:migrate": "node --env-file=.env server/scripts/migrate.mjs",
    "postinstall": "node scripts/link-lint-typescript.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.1.1",
    "genkit": "^1.41.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.0",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.1",
    "web-vitals": "6.2.1"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "qs": ">=6.16.0",
    "@opentelemetry/core": ">=2.8.0",
    "@opentelemetry/propagator-jaeger": ">=2.9.0",
    "@opentelemetry/exporter-prometheus": ">=0.217.0",
    "@opentelemetry/sdk-node": ">=0.217.0",
    "@opentelemetry/auto-instrumentations-node": ">=0.75.0"
  },
  "//overrides": "uuid: xcode@^7 (via @capacitor/cli) still declares uuid@^7, which carries a GHSA advisory; the override holds the tree at a patched major. Re-check when @capacitor/cli bumps its xcode dependency.",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "markdownlint-cli2": "^0.23.2",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.68.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
