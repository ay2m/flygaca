# Dependencies
node_modules/

# Build output
dist/
dev-dist/
server/lib/
*.tsbuildinfo

# Generated by build:sitemap (scripts/build-sitemap.mjs) on every `npm run build`.
# Committing them caused recurring merge conflicts on regenerated lastmod dates;
# the build always regenerates them into public/ → dist/.
public/sitemap.xml
public/robots.txt

# Coverage reports
coverage/

# Playwright
test-results/
playwright-report/
blob-report/
/playwright/.cache/

# Capacitor platform projects are generated on the Mac, never committed — and
# the per-flavor pipeline (scripts/flavor-ios.mjs) regenerates ios/ for ONE
# flavor at a time, so a committed project would always be the wrong app.
# See docs/RUNBOOK-native.md.
/ios/
/android/

# Xcode user state / caches
xcuserdata/
*.xcuserstate
DerivedData/

# Per-flavor staged public dir (built by scripts/build-flavor.mjs)
.flavor/

# Native iOS — generated by XcodeGen / xcodebuild (apple/project.yml is the source)
apple/FlyGACA.xcodeproj/
apple/.build/
# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.local

# Env
.env

# Firebase Data Connect — generated scaffolding from `firebase init`
dataconnect/
src/dataconnect-generated/
server/src/dataconnect-generated/
.env.local
.env.*.local

# Cloudflare Wrangler (local dev cache + state)
.wrangler/

# Terraform (local provider cache + state)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup

# Logs
npm-debug.log*
*.log
.vercel

# Generated reports
eslint-report.json

# GACA sync — fetched source HTML/PDF assets (regenerated on demand)
sync-input/assets/

# Generated Captain Adel source art (regenerate via npm run gen:captain) — kept out of the deploy
captain-art/

# Python bytecode (skill helper scripts)
__pycache__/
*.py[cod]
public/data/airports-shards/
public/data/library-shards/
.env*

# Metrics collection (git-ignored)
.stats.json

# Supabase CLI local cache
supabase/.temp/
